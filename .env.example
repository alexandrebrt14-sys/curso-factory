# curso-factory — Chaves de API (5 LLMs)
# Copie para .env e preencha com suas chaves reais
# Fonte de verdade: geo-orchestrator/.env
# Modelos: catalog/model_catalog.yaml do geo-orchestrator (task_routing), espelhado
# em config/providers.yaml e nos agentes de src/agents/.
#
# Toda variável lida pelo código está declarada em src/config.py; este arquivo
# lista as mesmas, com o valor padrão. Variável ausente = padrão.

# Perplexity — Pesquisa (sonar-deep-research)
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxx

# OpenAI — Redação (gpt-5.5)
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# Google — Análise (gemini-3.1-pro-preview) e classificação (gemini-3.7-flash)
GOOGLE_API_KEY=AIzaxxxxxxxxxxxx

# Groq — fora do parque do geo-orchestrator desde 2026-07-08; só fallback opcional
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# Anthropic — Revisão e tradução (claude-sonnet-5)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# Modelo Claude usado pelo revisor (AAA = Opus)
CLAUDE_MODEL=claude-sonnet-5

# Orçamento em USD. O orquestrador decide por CURSO e por SESSÃO
# (CostTracker.pode_chamar); o teto diário por provedor só alimenta o relatório.
# Quando um provedor cai e o fallback concentra tudo em outro, o teto por curso
# é o que protege o bolso sem cortar a revisão no meio.
DAILY_BUDGET_PER_PROVIDER=5.00
SESSION_BUDGET_TOTAL=5.00
CLAUDE_BUDGET_PER_COURSE=5.00
TOTAL_BUDGET_PER_COURSE=10.00
# Teto de saída por chamada (tokens); providers.yaml pode fixar teto menor por provedor
MAX_TOKENS_PER_CALL=16384

# Insumos por etapa (caracteres) e revisão
DRAFT_RESEARCH_CONTEXT_CHARS=40000
# Aula abaixo do piso ganha uma passada de expansão (1 liga, 0 desliga)
DRAFT_EXPANSAO_ABAIXO_DO_PISO=1
CLASSIFY_CONTEXT_CHARS=60000
REVIEW_ANALYSIS_CHARS=3000
# Revisão com menos que esta fração das palavras do rascunho é descartada
# (vale para o orquestrador E para o conversor de drafts)
REVIEW_MIN_RATIO=0.6
# Fechamento da trilha: aulas do módulo e pesquisa que viajam no prompt
TRAIL_LESSONS_CHARS=60000
TRAIL_RESEARCH_CHARS=20000

# Transporte e backend LLM
# Timeout de leitura HTTP (segundos); research em sonar-deep-research passa de minutos
HTTP_TIMEOUT=600
# "sdk" delega ao geo_orchestrator_sdk (timeout por task_type, fallback e FinOps
# do orquestrador); qualquer outro valor usa o cliente httpx próprio
CURSO_FACTORY_LLM_BACKEND=
# Clone do geo-orchestrator quando o backend é "sdk"
GEO_ORCHESTRATOR_PATH=~/geo-orchestrator

# Cache de respostas LLM em .cache/ (segundos; 0 desliga na prática)
CACHE_TTL_SECONDS=3600

# Cliente padrão quando a CLI não recebe --client
CURSO_FACTORY_CLIENT=default
# Segredo HMAC dos certificados (`cli certify`); vazio exige --secret
CERTIFICATE_SECRET=

# Integração com a landing page (só leitura de caminho; nada é gravado lá)
LANDING_PAGE_DIR=../landing-page-geo
