# curso-factory — Chaves de API (5 LLMs)
# Copie para .env e preencha com suas chaves reais
# Fonte de verdade: geo-orchestrator/.env
# Modelos: catalog/model_catalog.yaml do geo-orchestrator (task_routing), espelhado
# em config/providers.yaml e nos agentes de src/agents/.

# Perplexity — Pesquisa (sonar-deep-research)
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxx

# OpenAI — Redação (gpt-5.5)
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# Google — Análise (gemini-3.1-pro-preview) e classificação (gemini-3.7-flash)
GOOGLE_API_KEY=AIzaxxxxxxxxxxxx

# Groq — fora do parque do geo-orchestrator desde 2026-07-08; só fallback opcional
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# Anthropic — Revisão e tradução (claude-sonnet-5)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Orçamento em USD. O orquestrador decide por CURSO e por SESSÃO
# (CostTracker.pode_chamar); o teto diário por provedor só alimenta o relatório.
# Quando um provedor cai e o fallback concentra tudo em outro, o teto por curso
# é o que protege o bolso sem cortar a revisão no meio.
DAILY_BUDGET_PER_PROVIDER=5.00
SESSION_BUDGET_TOTAL=5.00
CLAUDE_BUDGET_PER_COURSE=5.00
TOTAL_BUDGET_PER_COURSE=10.00

# Insumos por etapa (caracteres) e revisão
DRAFT_RESEARCH_CONTEXT_CHARS=40000
# Aula abaixo do piso ganha uma passada de expansão (1 liga, 0 desliga)
DRAFT_EXPANSAO_ABAIXO_DO_PISO=1
CLASSIFY_CONTEXT_CHARS=60000
REVIEW_ANALYSIS_CHARS=3000
REVIEW_MIN_RATIO=0.6

# Cache
CACHE_DIR=.cache
CACHE_TTL_HOURS=24
